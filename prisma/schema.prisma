// ProMassage — Academy (Education) database schema
// ORM: Prisma · Datasource: PostgreSQL
//
// SCOPE: This schema models ONLY the Education/Academy module. The Clinic module
// (massage services, booking) is external — it connects to JaneApp and has no
// database presence here. Keep these worlds separate (CONTRIBUTING.md §15).
//
// To activate: `npm i -D prisma && npm i @prisma/client` → `npx prisma migrate dev`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth (shared by /account [student] and /admin [admin] — ONE system, role field)
// ---------------------------------------------------------------------------

enum UserRole {
  student
  admin
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(student)

  firstName String
  lastName  String
  phone     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations (student-facing)
  enrollments  Enrollment[]
  payments     Payment[]
  certificates Certificate[]
  attendance   Attendance[]

  // Relations (admin-facing audit trails)
  recordedAttendance   Attendance[]  @relation("AttendanceRecordedBy")
  issuedCertificates   Certificate[] @relation("CertificateIssuedBy")
  authoredCourses      Course[]      @relation("CourseCreatedBy")

  // Auth.js adapter relations (used for future OAuth/email; credentials use JWT)
  accounts Account[]
  sessions Session[]

  @@index([role])
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth) adapter models — standard shape required by @auth/prisma-adapter
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Course (migrated from src/data/programs.ts — now admin-managed CMS content)
// ---------------------------------------------------------------------------

enum CourseCategory {
  Introductory
  ProfessionalDiploma
  ContinuingEducation
}

model Course {
  id       String         @id @default(cuid())
  slug     String         @unique
  name     String
  category CourseCategory

  // Hours
  theoryHours    Int
  practicalHours Int
  totalHours     Int

  // Three-tier pricing (CAD). Only `priceGroup` is shown publicly (CLAUDE.md rule).
  priceGroup          Int
  priceSemiIndividual Int
  priceIndividual     Int

  prerequisites String  @db.Text
  description   String  @db.Text
  highlights    String[] // Postgres text[]
  tag           String
  instructor    String

  published Boolean @default(true)

  createdById String?
  createdBy   User?   @relation("CourseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  intakes      CourseIntake[]
  enrollments  Enrollment[]
  certificates Certificate[]

  @@index([category])
  @@index([published])
}

// ---------------------------------------------------------------------------
// Schedule: a CourseIntake is one scheduled offering of a Course (Fall/Winter/Spring)
// ---------------------------------------------------------------------------

enum IntakeSeason {
  Fall
  Winter
  Spring
  Summer
}

enum IntakeStatus {
  scheduled
  open
  full
  in_progress
  completed
  cancelled
}

model CourseIntake {
  id       String       @id @default(cuid())
  courseId String
  course   Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  season   IntakeSeason
  year     Int
  startDate DateTime
  endDate   DateTime
  capacity  Int
  status    IntakeStatus @default(scheduled)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions    CourseSession[]
  enrollments Enrollment[]

  @@index([courseId])
  @@index([status])
  @@index([year, season])
}

model CourseSession {
  id       String       @id @default(cuid())
  intakeId String
  intake   CourseIntake @relation(fields: [intakeId], references: [id], onDelete: Cascade)

  title     String
  date      DateTime
  startTime String? // "18:00" — kept as text; session time-of-day, not a full datetime
  endTime   String?

  attendance Attendance[]

  @@index([intakeId])
  @@index([date])
}

// ---------------------------------------------------------------------------
// Enrollment: Student ↔ Course (optionally tied to a specific CourseIntake/cohort)
// ---------------------------------------------------------------------------

enum PricingTier {
  group
  semi_individual
  individual
}

enum EnrollmentStatus {
  pending_payment
  active
  completed
  cancelled
}

model Enrollment {
  id        String @id @default(cuid())
  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  intakeId String?
  intake   CourseIntake? @relation(fields: [intakeId], references: [id], onDelete: SetNull)

  pricingTier PricingTier      @default(group)
  status      EnrollmentStatus @default(pending_payment)
  // Price captured at enrollment time (source Course prices may later change).
  amountDueCents Int

  enrolledAt  DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  payments    Payment[]
  attendance  Attendance[]
  certificate Certificate?

  // A student cannot enroll in the same intake of the same course twice.
  @@unique([studentId, courseId, intakeId])
  @@index([status])
  @@index([courseId])
}

// ---------------------------------------------------------------------------
// Payment: one or more payments settle an Enrollment (installments allowed)
// ---------------------------------------------------------------------------

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum PaymentProvider {
  square
  manual
}

model Payment {
  id           String @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  amountCents Int
  currency    String          @default("CAD")
  status      PaymentStatus   @default(pending)
  provider    PaymentProvider @default(square)
  providerRef String? // Square order id (or provider-specific reference)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enrollmentId])
  @@index([studentId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Attendance: per CourseSession, per Enrollment
// ---------------------------------------------------------------------------

enum AttendanceStatus {
  present
  absent
  late
  excused
}

model Attendance {
  id        String @id @default(cuid())
  sessionId String
  session   CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  // Denormalized student for convenient student-side queries.
  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  status AttendanceStatus @default(present)

  recordedById String?
  recordedBy   User?   @relation("AttendanceRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  recordedAt DateTime @default(now())

  @@unique([sessionId, enrollmentId])
  @@index([enrollmentId])
  @@index([studentId])
}

// ---------------------------------------------------------------------------
// Certificate: issued once per completed Enrollment (PDF generation = FUTURE)
// ---------------------------------------------------------------------------

enum CertificateStatus {
  issued
  revoked
}

model Certificate {
  id           String @id @default(cuid())
  enrollmentId String @unique
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  certificateNumber String            @unique
  status            CertificateStatus @default(issued)
  // Populated by a future PDF pipeline; null until generated (see certificateService).
  pdfUrl            String?

  issuedById String?
  issuedBy   User?   @relation("CertificateIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)

  issuedAt DateTime @default(now())

  @@index([studentId])
  @@index([courseId])
}
