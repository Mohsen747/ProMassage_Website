# Copy to `.env` and fill in. Do not commit `.env` (see `.gitignore`).

# Server-only: Google Cloud key with Places API (Place Details) enabled.
# Used by `src/lib/googlePlace.ts` for place reviews (home testimonials) and rating helpers.
GOOGLE_MAPS_API_KEY=

# Public: your Google Maps Place ID (safe to expose; used for Place Details + Maps links).
NEXT_PUBLIC_GOOGLE_PLACE_ID=
