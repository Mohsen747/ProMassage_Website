# Copy to `.env` and fill in. Do not commit `.env` (see `.gitignore`).

# Server-only: Google Cloud key with Places API (Place Details) enabled.
# Used by `src/lib/googlePlace.ts` for place reviews (home testimonials) and rating helpers.
GOOGLE_MAPS_API_KEY=

# Public: your Google Maps Place ID (safe to expose; used for Place Details + Maps links).
NEXT_PUBLIC_GOOGLE_PLACE_ID=

# --- Academy / Education module -------------------------------------------

# PostgreSQL connection string for Prisma (Neon/Supabase/Vercel Postgres).
DATABASE_URL=

# Auth.js (NextAuth) — generate with `openssl rand -base64 32`.
AUTH_SECRET=
# Base URL used by Auth.js for callbacks (e.g. http://localhost:3001 in dev).
AUTH_URL=

# Square payments (Checkout API / payment links). Sandbox first.
# Access token + application/location IDs from the Square Developer dashboard.
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
# "sandbox" (default) or "production".
SQUARE_ENVIRONMENT=sandbox
# Webhook subscription: signature key + the exact notification URL configured in
# the Square dashboard. Both are required to verify incoming webhook signatures.
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=

# Transactional email (Resend) — password reset links.
# API key from the Resend dashboard.
RESEND_API_KEY=
# Verified sender address. Use `onboarding@resend.dev` for local/dev testing
# (can only deliver to your own Resend account email until a domain is verified).
EMAIL_FROM=onboarding@resend.dev
